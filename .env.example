# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API & Security Keys (Leave blank or use mock tokens in this template)
NEXT_PUBLIC_API_BASE_URL=/api
DATABASE_URL=
AUTH_SECRET=
API_SECRET_KEY=
