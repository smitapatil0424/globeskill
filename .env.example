# ==============================================================================
# GlobeSkill - Environment Configuration Template
# ==============================================================================
# DO NOT store actual secrets or production passwords in this file.
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API & Security Keys (Leave blank or use mock tokens in this template)
NEXT_PUBLIC_API_BASE_URL=/api
# Supabase Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Server-only: Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
